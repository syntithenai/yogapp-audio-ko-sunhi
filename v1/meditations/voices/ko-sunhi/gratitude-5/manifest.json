{
  "id": "gratitude-5",
  "voiceId": "ko-sunhi",
  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 164,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세를 취하거나, 더 나은 느낌이 들면 누워주세요.",
      "file": "c001.ogg",
      "durationSec": 8.52
    },
    {
      "index": 2,
      "text": "손을 편안히 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "눈을 부드럽게 감거나, 감으세요.",
      "file": "c003.ogg",
      "durationSec": 6.264
    },
    {
      "index": 4,
      "text": "천천히 숨을 들이마시세요.",
      "file": "c004.ogg",
      "durationSec": 4.752
    },
    {
      "index": 5,
      "text": "그리고 더 길게 숨을 내쉬세요.",
      "file": "c005.ogg",
      "durationSec": 5.448
    },
    {
      "index": 6,
      "text": "오늘 또는 이번 주에 도움이 된 작은 것을 떠올려보세요.",
      "file": "c006.ogg",
      "durationSec": 8.064
    },
    {
      "index": 7,
      "text": "일상적인 것일 수 있습니다. 따뜻한 물. 메시지. 벽에 비친 빛.",
      "file": "c007.ogg",
      "durationSec": 13.008
    },
    {
      "index": 8,
      "text": "[일시정지:21]",
      "file": "c008.ogg",
      "durationSec": 4.32
    },
    {
      "index": 9,
      "text": "부드럽게 인식 속에 그 것을 유지하세요.",
      "file": "c009.ogg",
      "durationSec": 6.12
    },
    {
      "index": 10,
      "text": "가슴이나 얼굴에 어떤 부드러움이 느껴지는지 알아보세요.",
      "file": "c010.ogg",
      "durationSec": 7.848
    },
    {
      "index": 11,
      "text": "[일시정지:26]",
      "file": "c011.ogg",
      "durationSec": 4.488
    },
    {
      "index": 12,
      "text": "조용히, 이 하나의 것에 감사하세요.",
      "file": "c012.ogg",
      "durationSec": 6.312
    },
    {
      "index": 13,
      "text": "여기서 함께해 주셔서 감사합니다.",
      "file": "c013.ogg",
      "durationSec": 5.688
    },
    {
      "index": 14,
      "text": "[пауза:21]",
      "file": "c014.ogg",
      "durationSec": 2.496
    },
    {
      "index": 15,
      "text": "이제 두 번째 것. 또 다른 작은 좋은 점입니다.",
      "file": "c015.ogg",
      "durationSec": 7.08
    },
    {
      "index": 16,
      "text": "[пауза:26]",
      "file": "c016.ogg",
      "durationSec": 2.808
    },
    {
      "index": 17,
      "text": "감사합니다.",
      "file": "c017.ogg",
      "durationSec": 3.648
    },
    {
      "index": 18,
      "text": "[пауза:15]",
      "file": "c018.ogg",
      "durationSec": 2.352
    },
    {
      "index": 19,
      "text": "그리고 하나 더. 세 번째입니다.",
      "file": "c019.ogg",
      "durationSec": 5.784
    },
    {
      "index": 20,
      "text": "[пауза:26]",
      "file": "c020.ogg",
      "durationSec": 2.808
    },
    {
      "index": 21,
      "text": "감사는 단순하게 하세요. 강요하지 마세요. 그냥 눈여겨보는 것만으로도 됩니다.",
      "file": "c021.ogg",
      "durationSec": 13.824
    },
    {
      "index": 22,
      "text": "[пауза:31]",
      "file": "c022.ogg",
      "durationSec": 2.832
    },
    {
      "index": 23,
      "text": "그 따뜻함 속에서 몇 번의 숨을 쉬며 휴식하세요.",
      "file": "c023.ogg",
      "durationSec": 7.176
    },
    {
      "index": 24,
      "text": "[пауза:41]",
      "file": "c024.ogg",
      "durationSec": 2.568
    },
    {
      "index": 25,
      "text": "한 번 더 쉽고 여유롭게 숨을 쉬세요.",
      "file": "c025.ogg",
      "durationSec": 6.288
    },
    {
      "index": 26,
      "text": "손가락을 살짝 움직이세요.",
      "file": "c026.ogg",
      "durationSec": 5.064
    },
    {
      "index": 27,
      "text": "준비되면 눈을 뜰 수 있습니다.",
      "file": "c027.ogg",
      "durationSec": 5.376
    },
    {
      "index": 28,
      "text": "이 감정을 몸에 조금씩 담아가세요.",
      "file": "c028.ogg",
      "durationSec": 5.808
    }
  ]
}
