{
  "id": "self-compassion-10",
  "voiceId": "ko-sunhi",
  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 215,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "도착할 시간을 가지세요.",
      "file": "c001.ogg",
      "durationSec": 4.512
    },
    {
      "index": 2,
      "text": "지지가 되는 자세로 앉거나 누워주세요.",
      "file": "c002.ogg",
      "durationSec": 5.808
    },
    {
      "index": 3,
      "text": "안전하다고 느껴진다면 눈을 감으세요.",
      "file": "c003.ogg",
      "durationSec": 6.24
    },
    {
      "index": 4,
      "text": "지면과의 접촉을 느껴보세요.",
      "file": "c004.ogg",
      "durationSec": 5.064
    },
    {
      "index": 5,
      "text": "천천히 숨을 들이마십니다.",
      "file": "c005.ogg",
      "durationSec": 4.728
    },
    {
      "index": 6,
      "text": "더 길게 숨을 내쉽니다.",
      "file": "c006.ogg",
      "durationSec": 4.656
    },
    {
      "index": 7,
      "text": "[일시정지:26]",
      "file": "c007.ogg",
      "durationSec": 4.488
    },
    {
      "index": 8,
      "text": "다시 한번.",
      "file": "c008.ogg",
      "durationSec": 3.408
    },
    {
      "index": 9,
      "text": "[일시정지:26]",
      "file": "c009.ogg",
      "durationSec": 4.488
    },
    {
      "index": 10,
      "text": "어깨를 내려놓으세요.",
      "file": "c010.ogg",
      "durationSec": 4.008
    },
    {
      "index": 11,
      "text": "배를 부드럽게 풀어주세요.",
      "file": "c011.ogg",
      "durationSec": 4.752
    },
    {
      "index": 12,
      "text": "[일시정지:32]",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "도움이 된다면 손을 가슴에 올려주세요.",
      "file": "c013.ogg",
      "durationSec": 6.696
    },
    {
      "index": 14,
      "text": "판단 없이 자신의 상태를 인식하세요.",
      "file": "c014.ogg",
      "durationSec": 6.432
    },
    {
      "index": 15,
      "text": "[일시정지:32]",
      "file": "c015.ogg",
      "durationSec": 4.632
    },
    {
      "index": 16,
      "text": "이것은 고통의 순간이거나, 보통의 인간적 긴장의 순간입니다.",
      "file": "c016.ogg",
      "durationSec": 9.144
    },
    {
      "index": 17,
      "text": "다른 사람들도 이와 같은 감정을 느낍니다.",
      "file": "c017.ogg",
      "durationSec": 6.696
    },
    {
      "index": 18,
      "text": "[일시정지:39]",
      "file": "c018.ogg",
      "durationSec": 4.32
    },
    {
      "index": 19,
      "text": "이 순간 나 자신에게 친절해지기를 바랍니다.",
      "file": "c019.ogg",
      "durationSec": 6.648
    },
    {
      "index": 20,
      "text": "[일시정지:32]",
      "file": "c020.ogg",
      "durationSec": 4.632
    },
    {
      "index": 21,
      "text": "나는 나를 그대로 받아들이기를 바랍니다.",
      "file": "c021.ogg",
      "durationSec": 6.696
    },
    {
      "index": 22,
      "text": "[일시정지:32]",
      "file": "c022.ogg",
      "durationSec": 4.632
    },
    {
      "index": 23,
      "text": "나는 내가 필요한 자비를 나에게 주기를 바랍니다.",
      "file": "c023.ogg",
      "durationSec": 7.296
    },
    {
      "index": 24,
      "text": "[일시정지:39]",
      "file": "c024.ogg",
      "durationSec": 4.32
    },
    {
      "index": 25,
      "text": "마음에 와닿는 구절을 반복하고, 그렇지 않은 것은 놓아두세요.",
      "file": "c025.ogg",
      "durationSec": 9.312
    },
    {
      "index": 26,
      "text": "[일시정지:52]",
      "file": "c026.ogg",
      "durationSec": 4.584
    },
    {
      "index": 27,
      "text": "지혜로운 친구가 말하듯이 자신에게 말하는 것을 상상해보세요.",
      "file": "c027.ogg",
      "durationSec": 8.784
    },
    {
      "index": 28,
      "text": "그들은 어떤 어조로 말할까요?",
      "file": "c028.ogg",
      "durationSec": 5.16
    },
    {
      "index": 29,
      "text": "지금 그 어조를 자신에게 제공하세요.",
      "file": "c029.ogg",
      "durationSec": 5.784
    },
    {
      "index": 30,
      "text": "[일시정지:65]",
      "file": "c030.ogg",
      "durationSec": 4.248
    },
    {
      "index": 31,
      "text": "자비를 숨을 통해 들이마십니다.",
      "file": "c031.ogg",
      "durationSec": 5.232
    },
    {
      "index": 32,
      "text": "혹독함을 숨을 통해 내쉽니다.",
      "file": "c032.ogg",
      "durationSec": 5.256
    },
    {
      "index": 33,
      "text": "[일시정지:78]",
      "file": "c033.ogg",
      "durationSec": 4.632
    },
    {
      "index": 34,
      "text": "[일시정지:39]",
      "file": "c034.ogg",
      "durationSec": 4.32
    },
    {
      "index": 35,
      "text": "호흡을 깊게 시작하세요.",
      "file": "c035.ogg",
      "durationSec": 4.704
    },
    {
      "index": 36,
      "text": "다시 방의 느낌을 느껴보세요.",
      "file": "c036.ogg",
      "durationSec": 4.992
    },
    {
      "index": 37,
      "text": "손가락과 발가락을 움직여보세요.",
      "file": "c037.ogg",
      "durationSec": 5.76
    },
    {
      "index": 38,
      "text": "준비가 되면 눈을 뜨세요.",
      "file": "c038.ogg",
      "durationSec": 4.752
    },
    {
      "index": 39,
      "text": "천천히 다음으로 넘어가세요.",
      "file": "c039.ogg",
      "durationSec": 4.872
    }
  ]
}
