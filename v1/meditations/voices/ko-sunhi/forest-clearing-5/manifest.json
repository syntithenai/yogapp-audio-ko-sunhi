{
  "id": "forest-clearing-5",
  "voiceId": "ko-sunhi",
  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 405,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세로 앉거나, 더 편하다면 누워주세요.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "손을 편안히 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "눈을 감거나, 시선을 부드럽게 해주세요.",
      "file": "c003.ogg",
      "durationSec": 6.936
    },
    {
      "index": 4,
      "text": "몸의 무게가 받쳐지고 있음을 느껴보세요.",
      "file": "c004.ogg",
      "durationSec": 6.192
    },
    {
      "index": 5,
      "text": "코로 천천히 숨을 들이마십니다.",
      "file": "c005.ogg",
      "durationSec": 5.16
    },
    {
      "index": 6,
      "text": "그리고 더 길고 쉬운 숨을 내쉽니다.",
      "file": "c006.ogg",
      "durationSec": 6.192
    },
    {
      "index": 7,
      "text": "다시 한 번. 부드럽게 들이마십니다.",
      "file": "c007.ogg",
      "durationSec": 5.928
    },
    {
      "index": 8,
      "text": "부드럽게 내쉽니다.",
      "file": "c008.ogg",
      "durationSec": 3.984
    },
    {
      "index": 9,
      "text": "생각이 흐르면 괜찮습니다. 숨으로 돌아가세요.",
      "file": "c009.ogg",
      "durationSec": 8.544
    },
    {
      "index": 10,
      "text": "부드러운 낙엽 아래에 길이 있는 것을 상상하세요.",
      "file": "c010.ogg",
      "durationSec": 6.864
    },
    {
      "index": 11,
      "text": "서두르지 않고 조용한 숲으로 걸어 들어갑니다.",
      "file": "c011.ogg",
      "durationSec": 7.176
    },
    {
      "index": 12,
      "text": "반점처럼 빛이 팔뚝을 스쳐갑니다.",
      "file": "c012.ogg",
      "durationSec": 6.072
    },
    {
      "index": 13,
      "text": "햇빛이 닿는 곳마다 부드러운 따뜻함을 느껴보세요.",
      "file": "c013.ogg",
      "durationSec": 7.752
    },
    {
      "index": 14,
      "text": "나무 사이를 스치는 시원한 바람을 느껴보세요.",
      "file": "c014.ogg",
      "durationSec": 6.456
    },
    {
      "index": 15,
      "text": "초록 땅, 나무껍질, 그리고 깨끗한 미네랄 냄새를 맡아보세요.",
      "file": "c015.ogg",
      "durationSec": 10.32
    },
    {
      "index": 16,
      "text": "길이 작은 풀밭으로 열립니다.",
      "file": "c016.ogg",
      "durationSec": 5.16
    },
    {
      "index": 17,
      "text": "이끼가 쓰러진 나무토막을 감싸고 있다. 당신은 앉는다.",
      "file": "c017.ogg",
      "durationSec": 9.912
    },
    {
      "index": 18,
      "text": "햇빛이 중심부에 고여 조용한 금빛처럼 보인다.",
      "file": "c018.ogg",
      "durationSec": 7.416
    },
    {
      "index": 19,
      "text": "얼굴에 그 따뜻함을 느껴보세요. 천천히, 부드럽게.",
      "file": "c019.ogg",
      "durationSec": 9.912
    },
    {
      "index": 20,
      "text": "바람이 머리카락을 스치며 이마를 시원하게 한다.",
      "file": "c020.ogg",
      "durationSec": 7.296
    },
    {
      "index": 21,
      "text": "먼 곳에서 새소리가 들려오고, 다시 잦아든다.",
      "file": "c021.ogg",
      "durationSec": 7.488
    },
    {
      "index": 22,
      "text": "당신의 호흡이 나뭇잎의 고요함과 맞물린다.",
      "file": "c022.ogg",
      "durationSec": 7.08
    },
    {
      "index": 23,
      "text": "신선한 공기를 들이마신다. 남아 있는 서두름을 내쉬어라.",
      "file": "c023.ogg",
      "durationSec": 9.768
    },
    {
      "index": 24,
      "text": "지면이 얼마나 안전하게 느껴지는지 알아차려라.",
      "file": "c024.ogg",
      "durationSec": 7.056
    },
    {
      "index": 25,
      "text": "canopy 위로 하늘은 얼마나 넓게 보이는지.",
      "file": "c025.ogg",
      "durationSec": 6.672
    },
    {
      "index": 26,
      "text": "바퀴벌레가 햇빛이 비치는 나무껍질을 천천히 건너간다.",
      "file": "c026.ogg",
      "durationSec": 8.592
    },
    {
      "index": 27,
      "text": "당신은 지금 여기에 있는 것 외에 갈 곳이 없다.",
      "file": "c027.ogg",
      "durationSec": 7.32
    },
    {
      "index": 28,
      "text": "따뜻한 빛이 다시 감긴 눈꺼풀 위에 고여 있다.",
      "file": "c028.ogg",
      "durationSec": 7.272
    },
    {
      "index": 29,
      "text": "시원한 공기가 칼라 밑으로 들어와 마치 친절한 손길처럼 스며든다.",
      "file": "c029.ogg",
      "durationSec": 9.576
    },
    {
      "index": 30,
      "text": "-cheek에 남아 있는 따뜻함을 계속 느껴보세요.",
      "file": "c030.ogg",
      "durationSec": 7.08
    },
    {
      "index": 31,
      "text": "숨을 내쉴 때 입술에 스며드는 시원한 공기를 계속 느껴보세요.",
      "file": "c031.ogg",
      "durationSec": 9.408
    },
    {
      "index": 32,
      "text": "이 숲속은 아무것도 요구하지 않는다. 단지 당신을 안고 있을 뿐이다.",
      "file": "c032.ogg",
      "durationSec": 11.28
    },
    {
      "index": 33,
      "text": "한 번 더 숨을 배까지 완전히 내려보내보세요.",
      "file": "c033.ogg",
      "durationSec": 6.792
    },
    {
      "index": 34,
      "text": "그리고 나뭇잎처럼 부드럽게 떠나가게 하세요.",
      "file": "c034.ogg",
      "durationSec": 6.96
    },
    {
      "index": 35,
      "text": "이제 천천히 숲속 가장자리를 따라 주의를 흩어보세요.",
      "file": "c035.ogg",
      "durationSec": 7.92
    },
    {
      "index": 36,
      "text": "양치식물. 그림자. 떡갈나무 기둥 밑에 있는 창백한 버섯.",
      "file": "c036.ogg",
      "durationSec": 12.0
    },
    {
      "index": 37,
      "text": "당신이 서두르지 않기 때문에 모든 것이 선명하게 보인다.",
      "file": "c037.ogg",
      "durationSec": 8.112
    },
    {
      "index": 38,
      "text": "무릎에 햇빛이 닿는 곳에서 다시 햇살의 따뜻함을 느껴보세요.",
      "file": "c038.ogg",
      "durationSec": 8.904
    },
    {
      "index": 39,
      "text": "목을 스치는 바람의 시원함을 느껴보세요.",
      "file": "c039.ogg",
      "durationSec": 6.312
    },
    {
      "index": 40,
      "text": "당신은 이곳에 오후 내내 머물 수 있다. 지금은 숨 몇 번이면 충분하다.",
      "file": "c040.ogg",
      "durationSec": 11.544
    },
    {
      "index": 41,
      "text": "이제 숨만으로 잠시 쉬어보세요.",
      "file": "c041.ogg",
      "durationSec": 5.4
    },
    {
      "index": 42,
      "text": "천천히 숨을 들이마십니다.",
      "file": "c042.ogg",
      "durationSec": 4.728
    },
    {
      "index": 43,
      "text": "천천히 숨을 내쉽니다.",
      "file": "c043.ogg",
      "durationSec": 4.392
    },
    {
      "index": 44,
      "text": "숨을 들이마십니다.",
      "file": "c044.ogg",
      "durationSec": 4.008
    },
    {
      "index": 45,
      "text": "숨을 내쉽니다.",
      "file": "c045.ogg",
      "durationSec": 3.672
    },
    {
      "index": 46,
      "text": "몸이 따뜻한 곳 anywhere에서 따뜻함을 느껴보세요.",
      "file": "c046.ogg",
      "durationSec": 7.848
    },
    {
      "index": 47,
      "text": "공기가 시원한 곳 anywhere에서 시원함을 느껴보세요.",
      "file": "c047.ogg",
      "durationSec": 7.728
    },
    {
      "index": 48,
      "text": "숨을 들이마십니다.",
      "file": "c048.ogg",
      "durationSec": 4.008
    },
    {
      "index": 49,
      "text": "숨을 내쉽니다.",
      "file": "c049.ogg",
      "durationSec": 3.672
    },
    {
      "index": 50,
      "text": "갈 곳도 없고, 고칠 것도 없습니다.",
      "file": "c050.ogg",
      "durationSec": 6.432
    },
    {
      "index": 51,
      "text": "숨을 들이마십니다.",
      "file": "c051.ogg",
      "durationSec": 4.008
    },
    {
      "index": 52,
      "text": "숨을 내쉽니다.",
      "file": "c052.ogg",
      "durationSec": 3.672
    },
    {
      "index": 53,
      "text": "조용한 숨을 몇 번 더 쉬며 여기서 쉬어보세요.",
      "file": "c053.ogg",
      "durationSec": 7.056
    },
    {
      "index": 54,
      "text": "언제든지 이곳으로 돌아올 수 있다는 것을 아세요.",
      "file": "c054.ogg",
      "durationSec": 7.32
    },
    {
      "index": 55,
      "text": "준비가 되면 숨을 깊게 하세요.",
      "file": "c055.ogg",
      "durationSec": 5.424
    },
    {
      "index": 56,
      "text": "손가락과 발가락을 움직여보세요.",
      "file": "c056.ogg",
      "durationSec": 5.76
    },
    {
      "index": 57,
      "text": "부드럽게 눈을 떠보세요.",
      "file": "c057.ogg",
      "durationSec": 4.584
    },
    {
      "index": 58,
      "text": "이 평화의 일부를 가지고 나가세요.",
      "file": "c058.ogg",
      "durationSec": 5.592
    }
  ]
}
