  "totalSec": 147,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세를 취하거나, 더 편하다면 누워주세요.",
      "file": "c001.ogg",
      "durationSec": 7.728
    },
    {
      "index": 2,
      "text": "손을 편안히 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "눈을 부드럽게 감거나, 감으세요.",
      "file": "c003.ogg",
      "durationSec": 6.264
    },
    {
      "index": 4,
      "text": "천천히 숨을 들이마십니다.",
      "file": "c004.ogg",
      "durationSec": 4.728
    },
    {
      "index": 5,
      "text": "그리고 더 길게 숨을 내쉽니다.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "조용한 비가 오는 날 창가에 앉아 있는 것을 상상해보세요.",
      "file": "c006.ogg",
      "durationSec": 8.04
    },
    {
      "index": 7,
      "text": "유리가 차갑고, 밖의 세상은 부드럽습니다.",
      "file": "c007.ogg",
      "durationSec": 7.296
    },
    {
      "index": 8,
      "text": "[일시정지:30]",
      "file": "c008.ogg",
      "durationSec": 4.272
    },
    {
      "index": 9,
      "text": "이야기 없이 비 소리를 들어보세요.",
      "file": "c009.ogg",
      "durationSec": 5.448
    },
    {
      "index": 10,
      "text": "작은 두드림. 가끔 더 무거운 떨어짐.",
      "file": "c010.ogg",
      "durationSec": 8.088
    },
    {
      "index": 11,
      "text": "[일시정지:36]",
      "file": "c011.ogg",
      "durationSec": 4.632
    },
    {
      "index": 12,
      "text": "깨끗한 습기 있는 공기를 맡아보세요.",
      "file": "c012.ogg",
      "durationSec": 5.616
    },
    {
      "index": 13,
      "text": "회색 빛을 보세요. 부드럽고 서두르지 않게.",
      "file": "c013.ogg",
      "durationSec": 8.544
    },
    {
      "index": 14,
      "text": "[일시정지:30]",
      "file": "c014.ogg",
      "durationSec": 4.272
    },
    {
      "index": 15,
      "text": "비 속에서 갈 곳은 없습니다.",
      "file": "c015.ogg",
      "durationSec": 4.92
    },
    {
      "index": 16,
      "text": "일시정지할 수 있는 허락을 받으세요.",
      "file": "c016.ogg",
      "durationSec": 5.592
    },
    {
      "index": 17,
      "text": "[일시정지:36]",
      "file": "c017.ogg",
      "durationSec": 4.632
    },
    {
      "index": 18,
      "text": "유리에 떨어지는 물의 리듬과 함께 숨을 쉬세요.",
      "file": "c018.ogg",
      "durationSec": 7.608
    },
    {
      "index": 19,
      "text": "[일시정지:45]",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "신경계가 신호를 받도록 하세요: 부드럽게 풀어지게.",
      "file": "c020.ogg",
      "durationSec": 7.92
    },
    {
      "index": 21,
      "text": "[일시정지:36]",
      "file": "c021.ogg",
      "durationSec": 4.632
    },
    {
      "index": 22,
      "text": "한 번 더 편안한 숨을 쉬세요.",
      "file": "c022.ogg",
      "durationSec": 5.352
    },
    {
      "index": 23,
      "text": "손가락을 움직여보세요.",
      "file": "c023.ogg",
      "durationSec": 4.464
    },
    {
      "index": 24,
      "text": "준비가 되면 눈을 떠주세요.",
      "file": "c024.ogg",
      "durationSec": 5.016
    },
    {
      "index": 25,
      "text": "이것을 조금만 가지고 가세요.",
      "file": "c025.ogg",
      "durationSec": 4.992
    }
  ]
}
