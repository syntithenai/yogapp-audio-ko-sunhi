{
  "id": "gratitude-expand-10",
  "voiceId": "ko-sunhi",
  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 198,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "도착할 시간을 가져보세요.",
      "file": "c001.ogg",
      "durationSec": 4.8
    },
    {
      "index": 2,
      "text": "지지가 되는 자세로 앉거나 누워주세요.",
      "file": "c002.ogg",
      "durationSec": 5.808
    },
    {
      "index": 3,
      "text": "안전하다고 느껴진다면 눈을 감아보세요.",
      "file": "c003.ogg",
      "durationSec": 6.432
    },
    {
      "index": 4,
      "text": "지면과의 접촉을 느껴보세요.",
      "file": "c004.ogg",
      "durationSec": 5.064
    },
    {
      "index": 5,
      "text": "천천히 숨을 들이마시세요.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "길게 숨을 내쉬세요.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[일시정지:27]",
      "file": "c007.ogg",
      "durationSec": 4.464
    },
    {
      "index": 8,
      "text": "다시 한번.",
      "file": "c008.ogg",
      "durationSec": 3.408
    },
    {
      "index": 9,
      "text": "[일시정지:27]",
      "file": "c009.ogg",
      "durationSec": 4.464
    },
    {
      "index": 10,
      "text": "어깨를 내려놓으세요.",
      "file": "c010.ogg",
      "durationSec": 4.008
    },
    {
      "index": 11,
      "text": "배를 부드럽게 느껴보세요.",
      "file": "c011.ogg",
      "durationSec": 4.8
    },
    {
      "index": 12,
      "text": "[일시정지:34]",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "작고 구체적인 선물을 하나 시작하세요.",
      "file": "c013.ogg",
      "durationSec": 6.048
    },
    {
      "index": 14,
      "text": "그것을 붙잡고, 감사하세요.",
      "file": "c014.ogg",
      "durationSec": 5.76
    },
    {
      "index": 15,
      "text": "[일시정지:40]",
      "file": "c015.ogg",
      "durationSec": 4.152
    },
    {
      "index": 16,
      "text": "두 번째로, 사람, 장소, 또는 위안이 되는 것.",
      "file": "c016.ogg",
      "durationSec": 8.592
    },
    {
      "index": 17,
      "text": "감사합니다.",
      "file": "c017.ogg",
      "durationSec": 3.648
    },
    {
      "index": 18,
      "text": "[일시정지:40]",
      "file": "c018.ogg",
      "durationSec": 4.152
    },
    {
      "index": 19,
      "text": "세 번째로, 오늘 잘 작동하는 몸의 부분.",
      "file": "c019.ogg",
      "durationSec": 7.248
    },
    {
      "index": 20,
      "text": "감사합니다.",
      "file": "c020.ogg",
      "durationSec": 3.648
    },
    {
      "index": 21,
      "text": "[일시정지:40]",
      "file": "c021.ogg",
      "durationSec": 4.152
    },
    {
      "index": 22,
      "text": "조금이라도 친절하게 대해준 사람들에게 확장하세요.",
      "file": "c022.ogg",
      "durationSec": 7.344
    },
    {
      "index": 23,
      "text": "[일시정지:54]",
      "file": "c023.ogg",
      "durationSec": 4.512
    },
    {
      "index": 24,
      "text": "지금 있는 장소로 확장하세요. 보금자리. 공기. 땅.",
      "file": "c024.ogg",
      "durationSec": 13.176
    },
    {
      "index": 25,
      "text": "[일시정지:54]",
      "file": "c025.ogg",
      "durationSec": 4.512
    },
    {
      "index": 26,
      "text": "감사가 어렵다면, 나타나려는 노력에 감사하세요.",
      "file": "c026.ogg",
      "durationSec": 7.944
    },
    {
      "index": 27,
      "text": "그것도 중요합니다.",
      "file": "c027.ogg",
      "durationSec": 4.056
    },
    {
      "index": 28,
      "text": "[일시정지:40]",
      "file": "c028.ogg",
      "durationSec": 4.152
    },
    {
      "index": 29,
      "text": "생겨난 온기를 그대로 유지하세요.",
      "file": "c029.ogg",
      "durationSec": 5.544
    },
    {
      "index": 30,
      "text": "또는 그 의도 자체를 유지하세요.",
      "file": "c030.ogg",
      "durationSec": 5.616
    },
    {
      "index": 31,
      "text": "[일시정지:90]",
      "file": "c031.ogg",
      "durationSec": 4.176
    },
    {
      "index": 32,
      "text": "[일시정지:40]",
      "file": "c032.ogg",
      "durationSec": 4.152
    },
    {
      "index": 33,
      "text": "호흡을 깊게 시작하세요.",
      "file": "c033.ogg",
      "durationSec": 4.704
    },
    {
      "index": 34,
      "text": "다시 방을 느껴보세요.",
      "file": "c034.ogg",
      "durationSec": 4.344
    },
    {
      "index": 35,
      "text": "손가락과 발가락을 움직여보세요.",
      "file": "c035.ogg",
      "durationSec": 5.76
    },
    {
      "index": 36,
      "text": "준비가 되면 눈을 떠주세요.",
      "file": "c036.ogg",
      "durationSec": 5.016
    },
    {
      "index": 37,
      "text": "천천히 다음 동작으로 넘어가세요.",
      "file": "c037.ogg",
      "durationSec": 5.664
    }
  ]
}
