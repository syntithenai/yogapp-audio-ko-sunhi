  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 144,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세를 취하거나, 더 편하다면 누워주세요.",
      "file": "c001.ogg",
      "durationSec": 7.728
    },
    {
      "index": 2,
      "text": "손을 자연스럽게 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.824
    },
    {
      "index": 3,
      "text": "눈을 부드럽게 하거나, 감으세요.",
      "file": "c003.ogg",
      "durationSec": 6.024
    },
    {
      "index": 4,
      "text": "천천히 숨을 들이마십니다.",
      "file": "c004.ogg",
      "durationSec": 4.728
    },
    {
      "index": 5,
      "text": "그리고 더 길게 숨을 내쉽니다.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "그게 쉬웠다고 꾸며낼 필요는 없습니다.",
      "file": "c006.ogg",
      "durationSec": 6.072
    },
    {
      "index": 7,
      "text": "피로의 진실을 허용하세요.",
      "file": "c007.ogg",
      "durationSec": 4.584
    },
    {
      "index": 8,
      "text": "[일시정지:31]",
      "file": "c008.ogg",
      "durationSec": 4.344
    },
    {
      "index": 9,
      "text": "배려를 숨에 담아 들이마십니다.",
      "file": "c009.ogg",
      "durationSec": 5.232
    },
    {
      "index": 10,
      "text": "괜찮아야 한다는 요구를 내뱉으며 뱉어냅니다.",
      "file": "c010.ogg",
      "durationSec": 6.84
    },
    {
      "index": 11,
      "text": "[일시정지:31]",
      "file": "c011.ogg",
      "durationSec": 4.344
    },
    {
      "index": 12,
      "text": "오늘 밤 나는 나 자신에게 부드럽게 하겠습니다.",
      "file": "c012.ogg",
      "durationSec": 7.08
    },
    {
      "index": 13,
      "text": "나는 그대로 쉬겠습니다.",
      "file": "c013.ogg",
      "durationSec": 4.656
    },
    {
      "index": 14,
      "text": "[일시정지:31]",
      "file": "c014.ogg",
      "durationSec": 4.344
    },
    {
      "index": 15,
      "text": "내일은 내가 줄 수 있는 것만 요구하길 바랍니다.",
      "file": "c015.ogg",
      "durationSec": 7.32
    },
    {
      "index": 16,
      "text": "[일시정지:31]",
      "file": "c016.ogg",
      "durationSec": 4.344
    },
    {
      "index": 17,
      "text": "몸이 지지받는 것을 느껴보세요.",
      "file": "c017.ogg",
      "durationSec": 5.16
    },
    {
      "index": 18,
      "text": "이 순간에는 더 이상 아무것도 필요하지 않습니다.",
      "file": "c018.ogg",
      "durationSec": 7.32
    },
    {
      "index": 19,
      "text": "[일시정지:45]",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "도움이 된다면 손을 가슴에 얹으세요.",
      "file": "c020.ogg",
      "durationSec": 6.408
    },
    {
      "index": 21,
      "text": "당신은 그것을 해냈습니다.",
      "file": "c021.ogg",
      "durationSec": 4.776
    },
    {
      "index": 22,
      "text": "[일시정지:38]",
      "file": "c022.ogg",
      "durationSec": 4.464
    },
    {
      "index": 23,
      "text": "한 번 더 편안한 숨을 쉬세요.",
      "file": "c023.ogg",
      "durationSec": 5.352
    },
    {
      "index": 24,
      "text": "손가락을 움직여보세요.",
      "file": "c024.ogg",
      "durationSec": 4.464
    },
    {
      "index": 25,
      "text": "준비가 되면 눈을 떠주세요.",
      "file": "c025.ogg",
      "durationSec": 5.016
    },
    {
      "index": 26,
      "text": "이 감정을 조금만 가지고 나가세요.",
      "file": "c026.ogg",
      "durationSec": 5.736
    }
  ]
}
