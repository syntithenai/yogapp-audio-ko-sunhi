{
  "id": "cove-shore-5",
  "voiceId": "ko-sunhi",
  "edgeVoice": "ko-KR-SunHiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 375,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세로 앉거나, 더 편하다면 누워보세요.",
      "file": "c001.ogg",
      "durationSec": 7.488
    },
    {
      "index": 2,
      "text": "손을 편안히 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "눈을 감거나, 시선을 부드럽게 하세요.",
      "file": "c003.ogg",
      "durationSec": 6.648
    },
    {
      "index": 4,
      "text": "몸의 무게가 지지되고 있는 것을 느껴보세요.",
      "file": "c004.ogg",
      "durationSec": 6.312
    },
    {
      "index": 5,
      "text": "코로 천천히 숨을 들이마십니다.",
      "file": "c005.ogg",
      "durationSec": 5.16
    },
    {
      "index": 6,
      "text": "그리고 더 길고 쉽게 숨을 내쉽니다.",
      "file": "c006.ogg",
      "durationSec": 6.288
    },
    {
      "index": 7,
      "text": "다시 한 번. 부드럽게 들이마십니다.",
      "file": "c007.ogg",
      "durationSec": 5.928
    },
    {
      "index": 8,
      "text": "부드럽게 내쉽니다.",
      "file": "c008.ogg",
      "durationSec": 3.984
    },
    {
      "index": 9,
      "text": "생각이 흐르면 괜찮습니다. 숨으로 돌아가세요.",
      "file": "c009.ogg",
      "durationSec": 8.544
    },
    {
      "index": 10,
      "text": "안전한 만에 도착하는 자신을 봅니다.",
      "file": "c010.ogg",
      "durationSec": 5.928
    },
    {
      "index": 11,
      "text": "절벽이 부드러운 연한 모래를 감싸고 있습니다.",
      "file": "c011.ogg",
      "durationSec": 6.96
    },
    {
      "index": 12,
      "text": "바다는 낮고 인내심 있는 파도로 움직입니다.",
      "file": "c012.ogg",
      "durationSec": 6.888
    },
    {
      "index": 13,
      "text": "온화한 태양이 어깨 위를 따뜻하게 합니다.",
      "file": "c013.ogg",
      "durationSec": 6.312
    },
    {
      "index": 14,
      "text": "소금기 있는 바람이 입술과 눈꺼풀을 시원하게 합니다.",
      "file": "c014.ogg",
      "durationSec": 7.848
    },
    {
      "index": 15,
      "text": "그 공기의 신선함이 가슴을 채우는 것을 느껴보세요.",
      "file": "c015.ogg",
      "durationSec": 7.296
    },
    {
      "index": 16,
      "text": "물가로 걸어가세요. 젖은 모래가 발을 감쌉니다.",
      "file": "c016.ogg",
      "durationSec": 8.88
    },
    {
      "index": 17,
      "text": "차가운 거품이 발목을 스치고 사라집니다.",
      "file": "c017.ogg",
      "durationSec": 6.432
    },
    {
      "index": 18,
      "text": "리듬은 간단합니다. 도착하세요. 부드럽게 하세요. 떠나세요.",
      "file": "c018.ogg",
      "durationSec": 13.44
    },
    {
      "index": 19,
      "text": "마른 모래가 따뜻한 곳에 앉으세요.",
      "file": "c019.ogg",
      "durationSec": 5.688
    },
    {
      "index": 20,
      "text": "손으로 등을 기대세요. 모래의 자글거리는 열을 느껴보세요.",
      "file": "c020.ogg",
      "durationSec": 9.864
    },
    {
      "index": 21,
      "text": "만의 조용함과 소란을 들어보세요.",
      "file": "c021.ogg",
      "durationSec": 5.64
    },
    {
      "index": 22,
      "text": "소금, 태양, 깨끗한 돌의 냄새를 맡아보세요.",
      "file": "c022.ogg",
      "durationSec": 8.064
    },
    {
      "index": 23,
      "text": "피부에 따뜻함. 숨을 들이쉴 때마다 시원함.",
      "file": "c023.ogg",
      "durationSec": 8.664
    },
    {
      "index": 24,
      "text": "멀리서 빛이 조용한 웃음처럼 반짝입니다.",
      "file": "c024.ogg",
      "durationSec": 6.744
    },
    {
      "index": 25,
      "text": "그것을 쫓을 필요 없습니다. 이미 여기 있습니다.",
      "file": "c025.ogg",
      "durationSec": 8.76
    },
    {
      "index": 26,
      "text": "파도가 더 멀리 이르고, 발가락을 시원하게 한 후 물러납니다.",
      "file": "c026.ogg",
      "durationSec": 8.88
    },
    {
      "index": 27,
      "text": "따뜻한 모래가 발을 되찾습니다.",
      "file": "c027.ogg",
      "durationSec": 5.376
    },
    {
      "index": 28,
      "text": "숨을 파도와 함께 움직이게 하세요 — 천천히 들이쉬고, 더 길게 내쉬세요.",
      "file": "c028.ogg",
      "durationSec": 10.464
    },
    {
      "index": 29,
      "text": "평화는 만 그 자체입니다. 당신은 그 안에 있습니다.",
      "file": "c029.ogg",
      "durationSec": 9.456
    },
    {
      "index": 30,
      "text": "어깨 사이의 따뜻함에 주의를 두세요.",
      "file": "c030.ogg",
      "durationSec": 5.832
    },
    {
      "index": 31,
      "text": "그리고 코끝에 있는 신선한 소금기 있는 공기에 주의를 두세요.",
      "file": "c031.ogg",
      "durationSec": 8.568
    },
    {
      "index": 32,
      "text": "부드러운 상상으로 절벽선을 따라가세요.",
      "file": "c032.ogg",
      "durationSec": 6.288
    },
    {
      "index": 33,
      "text": "낮에 따뜻해진 돌. 주름 속의 그늘은 시원합니다.",
      "file": "c033.ogg",
      "durationSec": 7.512
    },
    {
      "index": 34,
      "text": "가까운 곳에 작은 조류가 있는 웅덩이가 있다.",
      "file": "c034.ogg",
      "durationSec": 6.84
    },
    {
      "index": 35,
      "text": "가까이 다가갈 필요는 없다. 그곳에 있다는 것을 아는 것만으로 충분하다.",
      "file": "c035.ogg",
      "durationSec": 11.304
    },
    {
      "index": 36,
      "text": "또 다른 파도. 시원한 발목. 따뜻한 모래. 부드러운 숨결.",
      "file": "c036.ogg",
      "durationSec": 13.968
    },
    {
      "index": 37,
      "text": "해안가는 계속해서 같은 단순한 친절을 제공한다.",
      "file": "c037.ogg",
      "durationSec": 7.632
    },
    {
      "index": 38,
      "text": "떠나기 전에 다시 한번 받아들여라.",
      "file": "c038.ogg",
      "durationSec": 5.52
    },
    {
      "index": 39,
      "text": "이제 잠시 동안 숨결에만 머무르며 쉬어라.",
      "file": "c039.ogg",
      "durationSec": 6.576
    },
    {
      "index": 40,
      "text": "천천히 들이마신다.",
      "file": "c040.ogg",
      "durationSec": 4.104
    },
    {
      "index": 41,
      "text": "천천히 내쉬는.",
      "file": "c041.ogg",
      "durationSec": 3.672
    },
    {
      "index": 42,
      "text": "들어온다.",
      "file": "c042.ogg",
      "durationSec": 3.0
    },
    {
      "index": 43,
      "text": "내쉰다.",
      "file": "c043.ogg",
      "durationSec": 3.144
    },
    {
      "index": 44,
      "text": "몸이 따뜻한 곳마다 따뜻함을 느껴라.",
      "file": "c044.ogg",
      "durationSec": 6.024
    },
    {
      "index": 45,
      "text": "공기가 시원한 곳마다 시원함을 느껴라.",
      "file": "c045.ogg",
      "durationSec": 6.192
    },
    {
      "index": 46,
      "text": "들어온다.",
      "file": "c046.ogg",
      "durationSec": 3.0
    },
    {
      "index": 47,
      "text": "내쉰다.",
      "file": "c047.ogg",
      "durationSec": 3.144
    },
    {
      "index": 48,
      "text": "갈 곳도 없고, 고칠 것도 없다.",
      "file": "c048.ogg",
      "durationSec": 6.264
    },
    {
      "index": 49,
      "text": "들어온다.",
      "file": "c049.ogg",
      "durationSec": 3.0
    },
    {
      "index": 50,
      "text": "내쉰다.",
      "file": "c050.ogg",
      "durationSec": 3.144
    },
    {
      "index": 51,
      "text": "조용한 숨결 몇 번 동안 여기에 머무르라.",
      "file": "c051.ogg",
      "durationSec": 6.456
    },
    {
      "index": 52,
      "text": "언제든지 이곳으로 돌아올 수 있다는 것을 알아라.",
      "file": "c052.ogg",
      "durationSec": 7.512
    },
    {
      "index": 53,
      "text": "준비가 되면 숨결을 깊게 하라.",
      "file": "c053.ogg",
      "durationSec": 5.52
    },
    {
      "index": 54,
      "text": "손가락과 발가락을 움직여라.",
      "file": "c054.ogg",
      "durationSec": 5.376
    },
    {
      "index": 55,
      "text": "부드럽게 눈을 뜨라.",
      "file": "c055.ogg",
      "durationSec": 4.176
    },
    {
      "index": 56,
      "text": "이 평화의 일부를 가지고 나가라.",
      "file": "c056.ogg",
      "durationSec": 5.448
    }
  ]
}
