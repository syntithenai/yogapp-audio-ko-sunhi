  "totalSec": 143,
  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.24
    },
    {
      "index": 1,
      "text": "편안한 자세를 취하거나, 더 편하다면 누워주세요.",
      "file": "c001.ogg",
      "durationSec": 7.728
    },
    {
      "index": 2,
      "text": "손을 편안히 놓으세요.",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "눈을 부드럽게 하거나, 감으세요.",
      "file": "c003.ogg",
      "durationSec": 6.024
    },
    {
      "index": 4,
      "text": "천천히 숨을 들이마세요.",
      "file": "c004.ogg",
      "durationSec": 4.488
    },
    {
      "index": 5,
      "text": "그리고 더 길게 숨을 내쉽니다.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "몇 번의 호흡 사이클을 통해 시작하세요.",
      "file": "c006.ogg",
      "durationSec": 6.192
    },
    {
      "index": 7,
      "text": "[일시정지:28]",
      "file": "c007.ogg",
      "durationSec": 4.32
    },
    {
      "index": 8,
      "text": "이제 넓히세요. 소리를 포함하세요.",
      "file": "c008.ogg",
      "durationSec": 7.44
    },
    {
      "index": 9,
      "text": "가까운 것. 먼 것. 변하는 것. 고정된 것.",
      "file": "c009.ogg",
      "durationSec": 7.296
    },
    {
      "index": 10,
      "text": "[일시정지:28]",
      "file": "c010.ogg",
      "durationSec": 4.32
    },
    {
      "index": 11,
      "text": "몸의 감각을 포함하세요.",
      "file": "c011.ogg",
      "durationSec": 4.56
    },
    {
      "index": 12,
      "text": "접촉점. 온도. 부드러운 맥박.",
      "file": "c012.ogg",
      "durationSec": 9.36
    },
    {
      "index": 13,
      "text": "[일시정지:28]",
      "file": "c013.ogg",
      "durationSec": 4.32
    },
    {
      "index": 14,
      "text": "방의 공간을 포함하세요.",
      "file": "c014.ogg",
      "durationSec": 4.608
    },
    {
      "index": 15,
      "text": "주의를 열린 하늘처럼.",
      "file": "c015.ogg",
      "durationSec": 4.512
    },
    {
      "index": 16,
      "text": "[일시정지:34]",
      "file": "c016.ogg",
      "durationSec": 4.632
    },
    {
      "index": 17,
      "text": "생각은 날씨처럼 나타날 수 있습니다.",
      "file": "c017.ogg",
      "durationSec": 6.024
    },
    {
      "index": 18,
      "text": "그것들을 쫓거나 밀 필요는 없습니다.",
      "file": "c018.ogg",
      "durationSec": 5.88
    },
    {
      "index": 19,
      "text": "하늘은 그대로입니다.",
      "file": "c019.ogg",
      "durationSec": 4.2
    },
    {
      "index": 20,
      "text": "[일시정지:45]",
      "file": "c020.ogg",
      "durationSec": 4.296
    },
    {
      "index": 21,
      "text": "이 열린 들판에 머무르세요.",
      "file": "c021.ogg",
      "durationSec": 5.112
    },
    {
      "index": 22,
      "text": "[일시정지:45]",
      "file": "c022.ogg",
      "durationSec": 4.296
    },
    {
      "index": 23,
      "text": "한 번 더 편안한 숨을 쉬세요.",
      "file": "c023.ogg",
      "durationSec": 5.352
    },
    {
      "index": 24,
      "text": "손가락을 움직여보세요.",
      "file": "c024.ogg",
      "durationSec": 4.464
    },
    {
      "index": 25,
      "text": "준비가 되면 눈을 떠주세요.",
      "file": "c025.ogg",
      "durationSec": 5.016
    },
    {
      "index": 26,
      "text": "이것을 조금만 가지고 나가세요.",
      "file": "c026.ogg",
      "durationSec": 5.304
    }
  ]
}
